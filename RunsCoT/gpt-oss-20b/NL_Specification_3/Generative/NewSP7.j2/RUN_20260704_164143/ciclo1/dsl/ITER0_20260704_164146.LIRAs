Factory_Pipeline
agents:
\trobots: robot1, robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials, lasered_materials
robot1:
\t1: moveTo warehouse
\t2: pick raw_materials
\t3: moveTo surface_texturization_start
\t4: deposit raw_materials
\t5: pick texturized_materials
\t6: moveTo laser_start
\t7: deposit texturized_materials
\t8: pick lasered_materials
\t9: moveTo loading_area
\t10: deposit lasered_materials
robot2:
\t1: moveTo warehouse
\t2: pick raw_materials
\t3: moveTo surface_texturization_start
\t4: deposit raw_materials
\t5: pick texturized_materials
\t6: moveTo laser_start
\t7: deposit texturized_materials
\t8: pick lasered_materials
\t9: moveTo loading_area
\t10: deposit lasered_materials
