Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials

Robot1:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: moveTo surface_texturization_end
	5: moveTo laser_start
	6: moveTo laser_end
	7: moveTo loading_area
	8: deposit raw_materials

Robot2:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: moveTo surface_texturization_end
	5: if dist(Robot1, Robot2) > 5 else stop
	6: moveTo laser_start
	7: if dist(Robot1, Robot2) > 5 else stop
	8: moveTo laser_end
	9: if dist(Robot1, Robot2) > 5 else stop
	10: moveTo loading_area
	11: if dist(Robot1, Robot2) > 5 else stop
