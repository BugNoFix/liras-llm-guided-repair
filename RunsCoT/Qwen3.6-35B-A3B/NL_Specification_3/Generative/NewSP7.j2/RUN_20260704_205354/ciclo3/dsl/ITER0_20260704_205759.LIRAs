Factory_Pipeline
	agents:
		robots: Robot1, Robot2
	locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
	resources: raw_materials
Robot1:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: deposit raw_materials
	5: moveTo surface_texturization_end
	6: pick raw_materials
	7: moveTo laser_start
	8: deposit raw_materials
	9: moveTo laser_end
	10: pick raw_materials
	11: moveTo loading_area
	12: deposit raw_materials
Robot2:
	13: moveTo warehouse
	14: pick raw_materials
	15: moveTo surface_texturization_start
	16: deposit raw_materials
	17: moveTo surface_texturization_end
	18: pick raw_materials
	19: moveTo laser_start
	20: deposit raw_materials
	21: moveTo laser_end
	22: pick raw_materials
	23: moveTo loading_area
	24: deposit raw_materials
