Coffee_Delivery
agents:
	humans: Employee1
	robots: BaristaRobot
locations: coffee_room, office001
resources: coffee
BaristaRobot default stop:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo office001
	4: deposit coffee
success: !possess(BaristaRobot, coffee) && position(BaristaRobot, office001)
failure: tired
