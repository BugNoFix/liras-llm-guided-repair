Coffee_Delivery
agents:
	robots: Robot1
locations: coffee_room, office001
resources: coffee
Robot1 default stop:
	1:	moveTo coffee_room
	2:	pick coffee if !possess(Robot1, coffee) else stop
	3:	moveTo office001
	4:	deposit coffee if possess(Robot1, coffee) else stop
success: !possess(Robot1, coffee) && position(Robot1, office001)
failure: time(10)
