Coffee_Delivery
agents:
	humans: Nurse
	robots: Robot1
locations: room1, room2, coffee_room
resources: item1, coffee
Nurse:
	1: moveTo room1
Robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo room1
	4: deposit coffee
	5: stop
success: position(Robot1, room1) && possess(Robot1, coffee)
failure: dist(Robot1, room1)>50
