Coffee_Delivery
agents:
	humans: Employee1, Employee2
	robots: Robot1
locations: coffee_room, office001, office004
resources: coffee
Employee1:
	1: moveTo coffee_room
	2: moveTo office001
	3: moveTo coffee_room
	4: moveTo office004
Robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo office001
	4: deposit coffee
success: dist(Robot1, office001) <= 1
failure: time(1000)
