Coffee_Delivery
agents:
	humans: Nurse
	robots: Robot1
locations: coffee_room, office004
resources: coffee
Nurse:
	1: moveTo office004
Robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo office004
	4: deposit coffee
	5: stop
	6: follow Robot1 (office004)
	7: moveTo office004
success: position(Robot1, office004) == true
failure: time(100)
