Coffee_Delivery
agents:
	humans: Nurse
	robots: Robot1
locations: coffee_room, room1
resources: coffee

Robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo room1
	4: deposit coffee

Nurse:
	1: moveTo room1
	2: receiveFrom Robot1

success: position(Robot1, room1) && position(Nurse, room1) && possess(Robot1, coffee)
failure: time(700)
