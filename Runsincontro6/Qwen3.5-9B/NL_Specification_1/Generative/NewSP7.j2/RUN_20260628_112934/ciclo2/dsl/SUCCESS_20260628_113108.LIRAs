Coffee_Delivery
agents:
	humans: Nurse
	robots: Robot1
locations: room1, room2, coffee_room
resources: coffee, item1

Robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo room1
	4: deposit coffee

Nurse:
	1: moveTo room1
	2: receiveFrom Robot1

success: position(Robot1, room1) && position(Nurse, room1)
failure: time(50)
