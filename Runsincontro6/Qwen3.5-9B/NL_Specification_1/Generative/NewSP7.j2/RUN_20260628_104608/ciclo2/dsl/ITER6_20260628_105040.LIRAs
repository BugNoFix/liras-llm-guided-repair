Coffee_Delivery
	agents:
		humans: Alice
		robots: Robot1
	locations: room1, room2, coffee_room
	resources: coffee, item1
	Robot1:
		default moveTo room1
		1: moveTo coffee_room
		2: pick coffee
		3: moveTo room1
		4: deposit coffee
		success: possess(Robot1, coffee) && position(Robot1, room1)
		failure: time(20)
	Alice:
		1: moveTo room2
