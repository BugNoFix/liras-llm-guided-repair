Coffee_Delivery
agents:
	robots: Robot1
humans: Employee1, Employee2
locations: kitchen, bedroom, office001, coffee_room
resources: coffee, cup
Robot1:
	default stop
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo bedroom
	4: deposit coffee
	5: moveTo office001
	6: deposit coffee
	7: stop
	8: stop
success: robot_loc_target[0] == 1 && possess(Robot1, coffee) == 0
failure: time(0)
