Coffee_Delivery
agents:
	humans: human1
	robots: robot1
locations: office001, coffee_room
resources: coffee
human1:
	1: moveTo office001 if time(5) else stop
	2: receiveFrom robot1 until busy(robot1) else stop
robot1:
	1: moveTo coffee_room if time(5) else stop
	2: pick coffee if position(robot1, coffee_room) else stop
	3: moveTo office001 if position(robot1, coffee_room) != true else stop
	4: deposit coffee to human1 if position(robot1, office001) else stop
	success: time(10)
	failure: time(20)
