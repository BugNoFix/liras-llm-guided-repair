Coffee_Delivery
agents:
	humans: Employee1
	robots: Robot1
locations: coffee_room, office001
resources: coffee
Employee1:
	1: receiveFrom Robot1 coffee
	Robot1:
		default moveTo coffee_room
		1: moveTo coffee_room
		2: pick coffee
		3: moveTo office001
		4: deposit coffee
	success: pos(Robot1, office001) && possess(Robot1, coffee)
	failure: time(700)
	Robot1:
		1: moveTo coffee_room
		2: pick coffee
		3: moveTo office001
		4: deposit coffee
	success: pos(Robot1, office001) && possess(Robot1, coffee)
	failure: time(700)
	Employee1:
		1: receiveFrom Robot1 coffee
