Coffee_Delivery
	agents:
		humans: Nurse, Employee1
		robots: Robot1
	locations: kitchen, room1, room2, coffee_room
	resources: coffee
Robot1:
	1: moveTo coffee_room if time(5) else stop
	2: pick coffee if time(6) else stop
	3: moveTo room if time(5) else stop
	4: stop if time(3) else stop
Nurse:
	1: stop
	2: stop
	3: stop
	4: stop
success: time(20)
failure: time(10)
