Coffee_Delivery
agents:
	humans: Employee1, Employee2
	robots: Robot1
locations: coffee_room, office001
resources: coffee

Robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo office001
	4: deposit coffee
Employee1:
	5: moveTo office001
	6: receiveFrom Robot1 coffee Employee2:
	7: moveTo office001
	8: receiveFrom Robot1 coffee
success: possess(Robot1,coffee) && position(Employee1,office001)
failure: time(3) == 3
