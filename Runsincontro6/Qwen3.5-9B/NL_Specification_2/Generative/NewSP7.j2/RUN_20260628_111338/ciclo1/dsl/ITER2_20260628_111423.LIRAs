user_guided_transport
agents:
	humans: human1
	robots: robot1
locations: bedroom, kitchen, office001
resources: object
agent: human1:
default moveTo bedroom
1: moveTo bedroom
2: moveTo kitchen
agent: robot1:
default moveTo bedroom
