user_guided_transport
agents:
	humans: Human1
	robots: Robot1
locations: bedroom, kitchen
resources: object1

Human1:
	1: moveTo bedroom
	2: moveTo kitchen
	Robot1:
	1: moveTo bedroom
	2: pick object1
	3: follow Human1
success: position(Human1,kitchen) && position(Robot1,kitchen) && possess(Robot1,object1)
failure: time(60)
