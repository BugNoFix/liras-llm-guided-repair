user_guided_transport
	agents:
		humans: Nurse
		robots: Robot1
	locations: bedroom, kitchen
	resources: object
Nurse: default stop
	1: moveTo bedroom
	2: moveTo kitchen
Robot1: default stop
	1: moveTo bedroom
	2: pick object
	3: moveTo kitchen
success: position(Nurse, kitchen) && position(Robot1, kitchen) && possess(Robot1, object)
failure: time(20)
