user_guided_transport

agents:
	humans: Human1
	robots: Robot1
locations: bedroom, kitchen
resources: item1

Human1: default moveTo bedroom
	1: moveTo bedroom
	2: moveTo kitchen

Robot1: default moveTo bedroom
	1: moveTo bedroom
	2: pick item1
	3: follow Human1 (kitchen)

success: position (Robot1, kitchen) == kitchen && position (Human1, kitchen) == kitchen && possess (Robot1, item1)
