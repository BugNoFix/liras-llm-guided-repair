Pattern1
agents:
	humans: Nurse
	robots: Robot1
locations: bedroom, kitchen
resources: item1
Nurse:
	1: moveTo bedroom
	2: moveTo bedroom
	3: moveTo bedroom
	4: moveTo kitchen
Robot1:
	1: moveTo bedroom
	2: moveTo bedroom
	3: pick item1
	4: follow Nurse
	5: moveTo kitchen
	6: moveTo kitchen
	7: moveTo kitchen
	8: moveTo kitchen
success: position(Nurse, kitchen) == true && position(Robot1, kitchen) == true && possess(Robot1, item1) == true
failure: time(60)
