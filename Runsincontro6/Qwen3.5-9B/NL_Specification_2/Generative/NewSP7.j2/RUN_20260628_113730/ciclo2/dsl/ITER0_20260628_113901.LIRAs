user_guided_transport
agents:
	humans: Human1
	robots: Robot1
locations: bedroom, kitchen
resources: object
Human1:
	1: moveTo bedroom
	2: moveTo kitchen until true
Robot1:
	1: moveTo bedroom
	2: pick object if position(relative(Human1, bedroom)) == 0 else stop
	3: follow Human1 (kitchen) until position(Human1, kitchen) else stop
success: position(Human1, kitchen) && position(Robot1, kitchen) && possess(Robot1, object)
failure: time(700)
