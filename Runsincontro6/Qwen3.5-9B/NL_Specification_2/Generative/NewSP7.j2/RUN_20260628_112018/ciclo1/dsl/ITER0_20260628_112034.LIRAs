user_guided_transport
agents:
	humans: human1
	robots: robot1
locations: bedroom, kitchen
resources: item1
human1:
	1: moveTo bedroom
	3: moveTo kitchen
robot1:
	1: moveTo bedroom
	2: pick item1
	3: follow human1
success: position(human1, kitchen) && position(robot1, kitchen) && possess(robot1, item1)
failure:
