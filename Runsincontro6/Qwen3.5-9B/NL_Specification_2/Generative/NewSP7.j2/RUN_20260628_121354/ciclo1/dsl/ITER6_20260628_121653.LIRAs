user_guided_transport
agents:
	humans: Human1
	robots: Robot1
locations: bedroom, kitchen
resources: object

Human1: default stop
	1: moveTo bedroom
	2-3:
	4: moveTo kitchen

Robot1: default stop
	1: moveTo bedroom
	2: pick object
	3: moveTo kitchen
	4: stop

success: position(Human1, kitchen) && position(Robot1, kitchen) && possess(Robot1, object)
failure: position(Human1, kitchen) && position(Robot1, kitchen)
