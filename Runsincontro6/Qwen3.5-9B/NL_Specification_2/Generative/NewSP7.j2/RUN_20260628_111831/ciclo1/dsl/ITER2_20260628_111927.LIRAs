user_guided_transport
agents:
	humans: human1
	robots: robot1
locations: bedroom, kitchen
resources: object
human1: default moveTo
	1: moveTo bedroom
	2: moveTo kitchen
robot1: default moveTo
	1: moveTo bedroom
	2: pick object
	3: follow human1
success: position(human1, kitchen) && position(robot1, kitchen) && possess(robot1, object)
failure: time(1000)
