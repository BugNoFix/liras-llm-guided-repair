user_guided_transport
agents:
	humans: human1
	robots: robot1
locations: bedroom, kitchen
resources: object

human1:
	1: moveTo bedroom
	2: moveTo kitchen

robot1:
	1: moveTo bedroom
	3: pick object
	4: moveTo kitchen

success: dist(human1, kitchen) == 0 && dist(robot1, kitchen) == 0 && possess(robot1, object)
failure: time(1000)
