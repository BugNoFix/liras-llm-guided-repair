PatternName
agents:
	humans: Nurse
	robots: Robot1
locations: room1, room2, bedroom, kitchen
resources: item1
Nurse:
	1: moveTo bedroom
Robot1:
	1: moveTo bedroom
	2: pick item1 if position(Robot1, bedroom) else stop
	3: moveTo kitchen if possess(Robot1, item1) else stop
success: time(10)
failure: time(20)
