user_guided_transport
agents:
	humans: Human1
	robots: Robot1
locations: bedroom, kitchen
resources: item1
Human1:
	1: moveTo bedroom
	2: moveTo kitchen
Robot1:
	1: moveTo bedroom
	2: pick item1
	3: follow Human1
success: position(Human1, kitchen) && position(Robot1, kitchen) && possess(Robot1, item1)
failure: time(1000)
failure: position(Human1, bedroom) || position(Robot1, bedroom) || position(Human1, kitchen) && !position(Robot1, kitchen)
