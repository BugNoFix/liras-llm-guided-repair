user_guided_transport
agents:
	humans: Nurse
	robots: Robot1
locations: bedroom, kitchen
resources: object

Nurse:
	1: moveTo bedroom
	2: follow Robot1(run 5)
	3: moveTo kitchen
	4: stop

Robot1:
	1: moveTo bedroom else stop
	2: pick object
	3: follow Nurse(run 5)
	4: moveTo kitchen

success: position(Nurse, kitchen) && position(Robot1, kitchen)
failure: time(100)
