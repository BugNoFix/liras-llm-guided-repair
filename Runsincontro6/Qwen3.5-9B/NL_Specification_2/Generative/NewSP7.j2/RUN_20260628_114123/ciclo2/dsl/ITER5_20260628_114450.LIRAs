user_guided_transport
agents:
	humans: Nurse
	robots: Robot1
locations: room1, room2, office001
resources: item1, item2

Nurse:
	1: moveTo room1
	2: pick item1
	3: moveTo office001
	4: stop

Robot1:
	1: moveTo room1 else stop
	2: pick item2
	3: moveTo office001
	4: stop

success: position(Nurse, office001) && position(Robot1, office001)
failure: time(100)
