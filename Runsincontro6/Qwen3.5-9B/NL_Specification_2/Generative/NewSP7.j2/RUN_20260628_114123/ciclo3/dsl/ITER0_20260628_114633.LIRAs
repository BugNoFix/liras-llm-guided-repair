user_guided_transport
agents:
	humans: Nurse
	robots: Robot1
locations: bedroom, kitchen
resources: object

Nurse:
	1: moveTo bedroom
	2: moveTo kitchen if position(Robot1, kitchen) else moveTo kitchen
	3: moveTo kitchen

Robot1:
	1: moveTo bedroom
	2: pick object if position(Nurse, bedroom) else pick object
	3: moveTo kitchen

success: position(Nurse, kitchen) && position(Robot1, kitchen) && possess(Robot1, object)
failure: time(10)
