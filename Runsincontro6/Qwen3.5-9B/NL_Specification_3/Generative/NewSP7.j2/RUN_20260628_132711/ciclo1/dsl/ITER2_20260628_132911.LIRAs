Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials, lasered_materials

Robot1:
	default moveTo warehouse
	1: moveTo surface_texturization_start
	2: pick raw_materials
	3: moveTo surface_texturization_end
	4: deposit texturized_materials
	5: moveTo laser_start
	6: pick texturized_materials
	7: moveTo laser_end
	8: deposit lasered_materials
	9: moveTo loading_area
	10: deposit lasered_materials

Robot2:
	default moveTo warehouse
	1: moveTo surface_texturization_start
	2: pick raw_materials
	3: moveTo surface_texturization_end
	4: deposit texturized_materials
	5: moveTo laser_start
	6: pick texturized_materials
	7: moveTo laser_end
	8: deposit lasered_materials
	9: moveTo loading_area
	10: deposit lasered_materials

success: time(100)
failure: !time(100)
