Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials
Robot1:
	1: pick raw_materials at surface_texturization_start
	2: moveTo surface_texturization_end
	3: moveTo laser_start
	4: moveTo laser_end
	5: moveTo loading_area
	6: deposit raw_materials at loading_area
Robot2:
	1: pick raw_materials at surface_texturization_start
	2: moveTo surface_texturization_end
	3: moveTo laser_start
	4: moveTo laser_end
	5: moveTo loading_area
	6: deposit raw_materials at loading_area
success: time(100)
failure: time(200)
