Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials, lasered_materials
Robot1:
	1: pick raw_materials if position(Robot2, warehouse) else stop
	2: moveTo surface_texturization_start
	3: pick texturized_materials if time(10) else stop
	4: moveTo laser_start
	5: pick lasered_materials if time(5) else stop
	6: moveTo loading_area
	7: deposit lasered_materials if time(2) else stop
Robot2:
	1: pick raw_materials if position(Robot1, warehouse) else stop
	2: moveTo surface_texturization_start
	3: pick texturized_materials if time(10) else stop
	4: moveTo laser_start
	5: pick lasered_materials if time(5) else stop
	6: moveTo loading_area
	7: deposit lasered_materials if time(2) else stop
success: time(700)
failure: time(10)
