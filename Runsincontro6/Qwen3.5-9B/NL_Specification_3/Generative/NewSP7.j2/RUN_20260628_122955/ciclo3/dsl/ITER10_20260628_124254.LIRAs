Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials

Robot1:
	1: pick raw_materials if possess(Robot1, raw_materials) else stop
	2: moveTo warehouse
	3: moveTo surface_texturization_start
	4: deposit raw_materials if possess(Robot1, raw_materials) else stop
	5: moveTo surface_texturization_end
	6: pick raw_materials
	7: moveTo laser_start
	8: deposit raw_materials
	9: moveTo laser_end
	10: pick raw_materials
	11: moveTo loading_area
	12: deposit raw_materials

Robot2:
	1: pick raw_materials if possess(Robot2, raw_materials) else stop
	2: moveTo warehouse
	3: moveTo surface_texturization_start
	4: deposit raw_materials
	5: moveTo surface_texturization_end
	6: pick raw_materials
	7: moveTo laser_start
	8: deposit raw_materials
	9: moveTo laser_end
	10: pick raw_materials
	11: moveTo loading_area
	12: deposit raw_materials

success: position(Robot1, loading_area) == true && position(Robot2, loading_area) == true
failure: dist(Robot1, Robot2) <= 1
