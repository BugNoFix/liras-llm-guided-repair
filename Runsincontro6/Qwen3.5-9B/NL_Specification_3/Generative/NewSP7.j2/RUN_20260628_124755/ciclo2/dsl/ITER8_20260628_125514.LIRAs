Factory_Pipeline
agents:
	humans: 
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials

Robot1:
	1: moveTo warehouse
	2: moveTo surface_texturization_start
	3: moveTo surface_texturization_end
	4: moveTo laser_start
	5: moveTo laser_end
	6: moveTo loading_area
	success: time(10)
failure: time(5)

Robot2:
	1: moveTo warehouse
	2: moveTo surface_texturization_start
	3: moveTo surface_texturization_end
	4: moveTo laser_start
	5: moveTo laser_end
	6: moveTo loading_area
	success: time(10)
failure: time(5)
