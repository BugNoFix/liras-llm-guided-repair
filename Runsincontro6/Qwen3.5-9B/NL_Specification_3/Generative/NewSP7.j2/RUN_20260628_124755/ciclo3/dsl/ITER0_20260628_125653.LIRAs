Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials
Robot1:
	1: moveTo surface_texturization_start
	2: pickup raw_materials until position(Robot1, surface_texturization_start) else stop
	1-2: moveTo surface_texturization_start
	3: moveTo surface_texturization_end
	3: deposit raw_materials until position(Robot1, surface_texturization_end) else stop
	4: scooter surface_texturization_end
	5: moveTo laser_start
	6: pickup raw_materials until position(Robot1, laser_start) else stop
	7: moveTo laser_end
	8: deposit raw_materials until position(Robot1, laser_end) else stop
	9: moveTo loading_area
	10: deposit raw_materials until position(Robot1, loading_area) else stop
Robt2:
	1: moveTo surface_texturization_start
	2: pickup raw_materials until position(Robot2, surface_texturization_start) else stop
	1-2: moveTo surface_texturization_start
	3: moveTo surface_texturization_end
	3: deposit raw_materials until position(Robot2, surface_texturization_end) else stop
	4: moveTo laser_start
	5: pickup raw_materials until position(Robot2, laser_start) else stop
	6: moveTo laser_end
	7: deposit raw_materials until position(Robot2, laser_end) else stop
	8: moveTo loading_area
	9: deposit raw_materials until position(Robot2, loading_area) else stop
success: position(Robot1, loading_area) && position(Robot2, loading_area)
failure: time(15)
