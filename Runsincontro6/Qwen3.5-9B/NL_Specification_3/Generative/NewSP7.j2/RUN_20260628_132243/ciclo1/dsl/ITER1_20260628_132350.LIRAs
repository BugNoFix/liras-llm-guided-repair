RoboticAssemblyPattern
agents:
	humans: AssemblyWorker1
	robots: RoboticArm1
locations: room1, room2, office001, loading_area
resources: item1, item2, raw_materials
AssemblyWorker1: default stop
	1: moveTo room1
	2: pick item1
	3: moveTo room2
	4: deposit item1
RoboticArm1: default stop
	1: moveTo room1
	2: pick item2
	3: moveTo room2
	4: deposit item2
success: time(100)
failure: time(500)
