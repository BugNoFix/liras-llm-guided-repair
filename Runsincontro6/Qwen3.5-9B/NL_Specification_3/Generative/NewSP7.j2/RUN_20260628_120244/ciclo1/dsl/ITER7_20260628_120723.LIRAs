Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials, lasered_materials

Robot1: default moveTo warehouse:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: moveTo surface_texturization_end
	5: pick texturized_materials
	6: moveTo laser_start
	7: moveTo laser_end
	8: pick lasered_materials
	9: moveTo loading_area
	10: deposit lasered_materials else moveTo loading_area
success: position(Robot1, loading_area) == true
failure: dist(Robot1, warehouse) > 10 || position(Robot1, warehouse) == true

Robot2: default moveTo warehouse:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: moveTo surface_texturization_end
	5: pick texturized_materials
	6: moveTo laser_start
	7: moveTo laser_end
	8: pick lasered_materials
	9: moveTo loading_area
	10: deposit lasered_materials else moveTo loading_area
success: position(Robot2, loading_area) == true
failure: dist(Robot2, warehouse) > 10 || position(Robot2, warehouse) == true
