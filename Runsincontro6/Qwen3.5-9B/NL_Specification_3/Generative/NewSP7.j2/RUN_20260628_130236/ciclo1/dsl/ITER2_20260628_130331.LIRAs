Nurse_Robot_Cooperation

agents:
	humans: Nurse
	robots: Robot1
locations: room1, room2, kitchen, coffee_room
resources: coffee, raw_materials

Nurse: default moveTo room1
	1: moveTo kitchen
	2: pick coffee
	3: moveTo coffee_room
	4: deposit coffee
	5: moveTo room1

Robot1:
	1: moveTo room1
	2: pick raw_materials
	3: moveTo kitchen
	4: deposit raw_materials
	5: moveTo room1

success: time(100)
failure: time(0)
