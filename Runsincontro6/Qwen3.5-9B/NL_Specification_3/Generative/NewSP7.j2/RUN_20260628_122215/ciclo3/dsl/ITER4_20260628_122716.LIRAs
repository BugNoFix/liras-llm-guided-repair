Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials
Robot1:
	1: moveTo warehouse else stop
	2: pick raw_materials if dist(Robot1, surface_texturization_start) <= 5 else moveTo surface_texturization_start
	3: moveTo surface_texturization_start else moveTo surface_texturization_end
	4: deposit raw_materials
	5: moveTo laser_start else moveTo surface_texturization_end
	6: pick raw_materials if dist(Robot1, laser_start) <= 5 else moveTo laser_start
	7: moveTo laser_start else moveTo laser_end
	8: deposit raw_materials
	9: moveTo loading_area else stop
Robot2:
	1: moveTo warehouse else stop
	2: pick raw_materials if dist(Robot2, surface_texturization_start) <= 5 else moveTo surface_texturization_start
	3: moveTo surface_texturization_start else moveTo surface_texturization_end
	4: deposit raw_materials
	5: moveTo laser_start else moveTo surface_texturization_end
	6: pick raw_materials if dist(Robot2, laser_start) <= 5 else moveTo laser_start
	7: moveTo laser_start else moveTo laser_end
	8: deposit raw_materials
	9: moveTo loading_area else stop
success: time(10)
failure: time(20)
