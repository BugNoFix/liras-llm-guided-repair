Nurse_Robot_Cooperation

agents:
	humans: Nurse
	robots: Robot1
locations: kitchen, office001, coffee_room
resources: coffee, object

Nurse:
	1: moveTo kitchen
	2: pick coffee
	3: moveTo office001
	4: deposit coffee
	5: moveTo coffee_room
	6: stop

Robot1:
	1: moveTo kitchen
	2: pick object
	3: moveTo office001
	4: deposit object
	5: moveTo coffee_room
	6: stop

success: time(100)
failure: time(0)
