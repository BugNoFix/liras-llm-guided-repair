user_guided_transport
agents:
	humans: Alice
	robots: Robo1
locations: bedroom, kitchen
resources: object
Alice:
	1: moveTo bedroom
	2: moveTo kitchen
Robo1:
	1: moveTo bedroom
	2: pick object
	3: follow Alice(kitchen)
success: position(Alice, kitchen) && position(Robo1, kitchen) && possess(Robo1, object)
failure: !position(Alice, kitchen) || !position(Robo1, kitchen) || !possess(Robo1, object)
