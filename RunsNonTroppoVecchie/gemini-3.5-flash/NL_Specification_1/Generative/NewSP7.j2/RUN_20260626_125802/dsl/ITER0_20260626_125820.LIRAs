Coffee_Delivery
agents:
	humans: employee1
	robots: robot1
locations: coffee_room, office001
resources: coffee
robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo office001
	4: deposit coffee
employee1:
	1: moveTo office001
	2-3: 
	4: pick coffee
success: possess(employee1, coffee)
failure: time(100)
