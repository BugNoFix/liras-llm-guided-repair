LabTransportSystem
agents:
	humans: Nurse, LabPersonnel
	robots: RoboticArm
locations: PatientFloor, Laboratory, EntryModule
resources: Sample

Nurse:
	1: moveTo PatientFloor
	2: pick Sample
	3: deliver Sample
	4: moveTo Laboratory

RoboticArm:
	1: moveTo Laboratory
	2: pick Sample
	3: deliver Sample
	4: moveTo EntryModule

success: position(Nurse, Laboratory)&&position(RoboticArm, EntryModule)
failure: dist(Nurse, RoboticArm) > 100
