TransportationPattern
agents:
	robots:Robot1,Robot2
locations:Warehouse,SurfaceStart,SurfaceEnd,LaserStart,LaserEnd,LoadingArea
resources:RawMaterial

Robot1:
	1:moveTo Warehouse
	2:pick RawMaterial
	3:moveTo SurfaceStart
	4:deliver RawMaterial
	5:moveTo SurfaceEnd
	6:pick RawMaterial
	7:moveTo LaserStart
	8:deliver RawMaterial

Robot2:
	1:moveTo LaserEnd
	2:pick RawMaterial
	3:moveTo LoadingArea
	4:deposit RawMaterial

success:position(Robot2,LoadingArea)
failure:dist(Robot1,Robot2) < 0
