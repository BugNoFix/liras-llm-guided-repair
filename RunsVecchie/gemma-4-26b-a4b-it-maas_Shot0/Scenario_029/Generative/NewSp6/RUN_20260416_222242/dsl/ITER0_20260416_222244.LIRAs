ChemoWardTherapy
agents:
	humans: Nurse, Child, Parent
	robots: TherapyRobot, Cart
locations:
	Ward, TherapyArea
resources:
	Books

TherapyRobot:
	1: moveTo TherapyArea
	2: follow Child
	3: deliver Books until busy(Nurse)
	4: stop if busy(Nurse) else moveTo TherapyArea

Cart:
	1: moveTo TherapyArea
	2: deliver Books until busy(Nurse)
	3: stop if busy(Nurse) else moveTo TherapyArea

Nurse:
	1: moveTo TherapyArea
	2: receiveFrom TherapyRobot until time(100)

success: position(TherapyRobot, TherapyArea)
failure: busy(Nurse)
