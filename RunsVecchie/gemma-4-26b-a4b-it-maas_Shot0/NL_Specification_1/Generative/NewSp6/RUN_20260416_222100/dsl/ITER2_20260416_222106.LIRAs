CoffeeDeliveryTask
agents:
	humans: Employee
	robots: DeliveryRobot
locations: CoffeeMachine, Office
resources: Coffee
DeliveryRobot:
	1: moveTo CoffeeMachine
	2: fetch Coffee
	3: moveTo Office if position(DeliveryRobot, Office) == 0 else stop
	4: deliver Coffee
success: possess(DeliveryRobot, Coffee) == 0
failure: !possess(DeliveryRobot, Coffee)
