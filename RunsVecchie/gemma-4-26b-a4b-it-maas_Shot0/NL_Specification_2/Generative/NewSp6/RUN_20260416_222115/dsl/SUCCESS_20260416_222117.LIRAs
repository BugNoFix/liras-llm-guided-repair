HouseTask
agents:
	humans: Human1
	robots: Robot1
locations: Bedroom, Kitchen
resources: Object1
Human1:
	1: moveTo Bedroom
	2: moveTo Kitchen until position(Human1, Kitchen)
Robot1:
	1: moveTo Bedroom
	2: pick Object1
	3: follow Human1(Kitchen)
success: position(Human1, Kitchen) && position(Robot1, Kitchen) && possess(Robot1, Object1)
failure: !position(Human1, Kitchen) || !position(Robot1, Kitchen) || !possess(Robot1, Object1)
