LabTransport
agents:
	humans: Nurse, LabPerson
	robots: RobotArm
locations: PatientFloor, Laboratory, DrawerLocation, AnalysisMachine
resources: Sample, LockedDrawer, EntryModule
Nurse default stop:
	1: moveTo PatientFloor if !tired else stop
	2: pick Sample
	3: deposit LockedDrawer
	4: moveTo Laboratory
	5: deliver Sample
	6: stop
RobotArm default stop:
	1: moveTo Laboratory if position(RobotArm, Laboratory) && !busy(RobotArm) else stop
	2: pick Sample
	3: fetch Barcode
	4: deliver Sample to EntryModule
	5: stop
LabPerson default stop:
	1: moveTo Laboratory if position(LabPerson, Laboratory) && !busy(LabPerson) else stop
	2: pick Sample
	3: deliver Sample to EntryModule
	4: stop
success: position(RobotArm, AnalysisMachine) && !busy(RobotArm)
failure: dist(Nurse, RobotArm) > 10
