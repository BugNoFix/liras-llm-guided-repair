MaterialTransportPattern
agents:
	robots: Robot1, Robot2
locations: Warehouse, SurfaceStart, SurfaceEnd, LaserStart, LaserEnd, LoadingArea
resources: RawMaterial, ProcessedMaterial
Robot1:
	1: moveTo Warehouse
	2: fetch RawMaterial
	3: moveTo SurfaceStart
	4: deliver RawMaterial
	5: moveTo SurfaceEnd
	6: pick ProcessedMaterial
	7: moveTo LaserStart
	8: deliver ProcessedMaterial
	9: moveTo LaserEnd
	10: pick ProcessedMaterial
	11: moveTo LoadingArea
	12: deposit ProcessedMaterial
Robot2:
	1: moveTo Warehouse
	2: fetch RawMaterial
	3: moveTo SurfaceStart
	4: deliver RawMaterial
	5: moveTo SurfaceEnd
	6: pick ProcessedMaterial
	7: moveTo LaserStart
	8: deliver ProcessedMaterial
	9: moveTo LaserEnd
	10: pick ProcessedMaterial
	11: moveTo LoadingArea
	12: deposit ProcessedMaterial
