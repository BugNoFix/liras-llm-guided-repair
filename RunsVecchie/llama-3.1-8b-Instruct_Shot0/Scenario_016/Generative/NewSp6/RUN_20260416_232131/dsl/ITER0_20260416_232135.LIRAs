Robot_Instruction_System
humans: 
  - Human1
  - Human2

robots: 
  - Robot1

locations: 
  - Room_7002
  - Room_3201
  - 7th.Floor.Elevator

resources: 
  - Basket

Nurse: 
  1: moveTo 7002 
  2: until tired else stop
  3: if tired else stop
  4: receiveFrom Human1
  5: fetch Basket.Timer
  6: until Basket.Timer confirmed else stop
  7: navigate 7002
  8: until at Room_3201 else stop
    moveTo 7th.Floor.Elevator
    if time(10) else skip
  9: 
    stop
    1: skip 
    10: 
      receiveFrom Human2
      2: wait 5

success:  at Room_3201 && Basket.Timer confirmed 
failure: !at Room_3201 || !Basket.Timer confirmed
