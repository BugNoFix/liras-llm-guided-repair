Human:
agents:
humans: Human

Robot:
agents:
robots: Robot

locations: Bedroom, Kitchen
resources: Object

Sequence Human:
default stop
1: moveTo Bedroom
2: wait 1

Sequence Robot:
default stop
1: moveTo Bedroom
2: if tired else stop
3: fetch Object
4: wait 2
5: if still(Human, Bedroom) else stop

success: position(Human, Kitchen) && position(Robot, Kitchen) && possess(Robot, Object)

failure: position(Human, Bedroom) || position(Robot, Bedroom) || !possess(Robot, Object)

success: position(Human, Kitchen) && position(Robot, Kitchen) && possess(Robot, Object)
failure: position(Human, Bedroom) || position(Robot, Bedroom) || !possess(Robot, Object)
