RDF_Helix(.)=

agents:  

humans:
Nurse1, Nurse2

robots:
RDF_Helix

locations:
ChemotherapyWard,
TherapyArea,
CartChamber

resources:
AnxietyReductionKit,

Nurse1: default: 
1: moveTo ChemotherapyWard
2: moveTo TherapyArea
3: until 
    arrive(RDF_Helix, TherapyArea) 
      && time(10)

Nurse1: default: 
4: 
    if tired(RDF_Helix)
      else 
        follow(RDF_Helix, 
           randfrom([Child1, Child2, Parent1, Parent2, Parent3])
        )
        wait 1

Nurse2: default: 
5: until 
    arrive(RDF_Helix, TherapyArea) 
      && time(20)
6: 
    fetch AnxietyReductionKit
      send(Nurse2->RDF_Helix, prepareCart)
      gotoCart(RDF_Helix, CartChamber)
7: 
    wait 1
8: 
    receiveFrom RestClient
      randfrom([Book1, Book2])
      cond: ?loc('BesideChild') && succeed(RDF_Helix, giveBook)
9: 
    stop

success: 
    dfb('story_telling.printlog')
    location('ChemotherapyWard')

failure: 
    dfb('story_telling.healthInfo(RDF_Helix)')
