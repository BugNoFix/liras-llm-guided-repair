labProcedure:

agents:
humans: 
    <TAB> Nurse:
    <TAB> LaboratoryPersonnel:

robots:
    <TAB> RoboticArm:

locations:
    <TAB> Laboratory:
    <TAB> PatientFloor:
    <TAB> EntryModule:

resources:
    <TAB> SecureDrawer:
    <TAB> LockedDrawerKey:
    <TAB> BarcodeDevice:
    <TAB> TrackSystem:

Nurse: 
    <TAB> 1: moveTo PatientFloor 
        fetch SecureDrawer
        follow RoboticArm
    <TAB> 2: deposit LockedDrawerKey

RoboticArm: 
    <TAB> 1: 
        moveTo Laboratory 
        pick SecureDrawer
        receiveFrom Nurse
        moveTo EntryModule 
        pick BarcodeDevice
        scan BarcodeDevice
    <TAB> 2:
        unload JourneyTransporter 
        execute LoadSampleState

success:
    <TAB> dist(Nurse, Laboratory) == 0

failure:
    <TAB> time(60) > time(0)

laboratoryUse(l, h):
    <TAB> LaboratoryPersonnel: 
        <TAB> 1:
            <TAB> moveTo Laboratory 
            <TAB> pick SecureDrawer
            <TAB> follow RoboticArm
        <TAB> 2:
            <TAB> receiveFrom LaboratoryPersonnel 
            <TAB> move JourneyTransporter 
            <TAB> load DeltaSorter 
            <TAB> unload  SecureDrawer

Laboratory:
    <TAB> 1:
        <TAB> pwm(MovingMotor(EntryModule, Vel_Medium))
        <TAB> dock EntryModule

agents:
    <TAB> humans:
        <TAB> LaboratoryPersonnel:
            <TAB> 1:
                <TAB> stop
    <TAB> robots:
        <TAB> RoboticArm:
            <TAB> 1:
                <TAB> stop
    <TAB> robots:
        <TAB> RoboticArm:
            <TAB> 2:
                <TAB> stop
