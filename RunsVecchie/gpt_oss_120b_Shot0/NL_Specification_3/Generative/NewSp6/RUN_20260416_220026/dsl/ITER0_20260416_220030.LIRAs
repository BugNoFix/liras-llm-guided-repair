AutomatedTransport
agents:
	robots: RobotA, RobotB
locations: Warehouse, SurfaceStart, SurfaceEnd, LaserStart, LaserEnd, LoadingArea
resources: RawMaterial
RobotA:
	1: fetch RawMaterial
	2: moveTo SurfaceStart
	3: deliver RawMaterial
	4: moveTo SurfaceEnd
	5: pick RawMaterial
	6: moveTo LaserStart
	7: deliver RawMaterial
	8: moveTo LaserEnd
	9: pick RawMaterial
	10: moveTo LoadingArea
	11: leave RawMaterial
RobotB:
	1: fetch RawMaterial
	2: moveTo SurfaceStart
	3: deliver RawMaterial
	4: moveTo SurfaceEnd
	5: pick RawMaterial
	6: moveTo LaserStart
	7: deliver RawMaterial
	8: moveTo LaserEnd
	9: pick RawMaterial
	10: moveTo LoadingArea
	11: leave RawMaterial
success: position(RobotA, LoadingArea) && position(RobotB, LoadingArea)
failure: time(100)
