HotelDelivery
agents:
	humans: Guest
	robots: Butler
locations: Lobby,Room101
resources: Item
Butler:
	1: moveTo Lobby
	2: pick Item
	3: moveTo Room101
	4: deposit Item if position(Butler,Room101) else stop
Guest:
	1: receiveFrom Butler if position(Butler,Room101) else stop
success: possess(Guest,Item) && position(Butler,Room101)
failure: !possess(Guest,Item) || busy(Butler)
