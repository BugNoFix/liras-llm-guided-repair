ChemotherapySupport
agents:
	humans: Child1, Parent1, Nurse1
	robots: RobotA, CartA
locations: Ward, TherapyArea, Storage
resources: Book
RobotA default stop:
	1: moveTo TherapyArea if tired else stop
	2: fetch Book if !possess(RobotA,Book) else stop
	3: deliver Book if possess(RobotA,Book) else stop
CartA:
	1: fetch Book if !possess(CartA,Book) else stop
	2: deliver Book if possess(CartA,Book) else stop
success: possess(RobotA,Book) && position(RobotA,TherapyArea)
failure: busy(Nurse1)
