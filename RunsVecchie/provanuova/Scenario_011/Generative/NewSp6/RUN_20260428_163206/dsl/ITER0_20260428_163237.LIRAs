LabSampleTransport
agents:
	humans: Nurse, LabPersonnel
	robots: DeliveryRobot, RoboticArm
locations: PatientFloor, Laboratory, AnalysisMachine
resources: Sample

Nurse:
	1: moveTo PatientFloor
	2: pick Sample
	3: deliver Sample

DeliveryRobot:
	1: moveTo PatientFloor
	2: receiveFrom Nurse
	3: moveTo Laboratory
	4: deliver Sample

RoboticArm:
	1: moveTo Laboratory
	2: receiveFrom DeliveryRobot
	3: moveTo AnalysisMachine
	4: leave Sample

LabPersonnel:
	1: moveTo Laboratory
	2: stop

success: position(RoboticArm, AnalysisMachine)
failure: time(60)
