CoffeeDelivery
agents:
	humans: Employee
	robots: Robot
locations: coffee_room, office001
resources: coffee

Robot:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo office001
	4: deliver coffee

Employee:
	1: moveTo office001
	2-3: stop until position(Robot, office001)
	4: receiveFrom Robot

success: possess(Employee, coffee)
