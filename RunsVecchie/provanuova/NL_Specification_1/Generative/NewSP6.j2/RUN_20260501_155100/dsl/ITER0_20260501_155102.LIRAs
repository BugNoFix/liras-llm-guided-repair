UniversityDelivery

agents:
	humans: Employee
	robots: Robot
locations: coffee_room, office001
resources: coffee

Robot:
	1: moveTo coffee_room
	2: fetch coffee
	3: moveTo office001
	4: deliver coffee

Employee:
	1: moveTo office001

success: position(Robot, office001) && possess(Employee, coffee)
failure: !position(Robot, office001)
