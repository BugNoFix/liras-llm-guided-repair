HouseTask
agents:
	humans: H1
	robots: R1
locations: bedroom, kitchen
resources: object
H1:
	1: moveTo bedroom
	2: stop until possess(R1, object)
	3: moveTo kitchen
R1:
	1: moveTo bedroom
	2: stop until position(H1, bedroom)
	3: pick object
	4: follow H1(kitchen)
success: position(H1, kitchen) && position(R1, kitchen) && possess(R1, object)
failure: time(100)
