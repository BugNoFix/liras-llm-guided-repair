HouseTask
agents:
	humans: Human1
	robots: Robot1
locations:
	bedroom, kitchen
resources:
	object
Human1:
	1: moveTo bedroom
	2: moveTo kitchen until position(Human1, kitchen)
Robot1:
	1: moveTo bedroom
	2: pick object until position(Robot1, bedroom)
	3: follow Human1(kitchen) until position(Robot1, kitchen)
success: position(Human1, kitchen) && position(Robot1, kitchen) && possess(Robot1, object)
failure: !position(Human1, kitchen) || !position(Robot1, kitchen) || !possess(Robot1, object)
