LabSampleTransport
agents:
	humans: Nurse, LabPersonnel
	robots: DeliveryRobot, RoboticArm
locations: PatientFloor, Laboratory, AnalysisMachine
resources: Sample
Nurse:
	1: pick Sample
	2: moveTo PatientFloor
	3: stop until !possess(Nurse, Sample)
DeliveryRobot:
	1: moveTo PatientFloor
	2: receiveFrom Nurse
	3: moveTo Laboratory
	4: leave Sample
RoboticArm:
	1: moveTo Laboratory
	2: stop until position(DeliveryRobot, Laboratory)
	3: pick Sample
	4: moveTo AnalysisMachine
	5: leave Sample
success: position(RoboticArm, AnalysisMachine) && !possess(RoboticArm, Sample)
failure: time(120)
