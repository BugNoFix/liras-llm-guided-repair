ChemoTherapyStorytelling
agents:
	humans: Child, Parent, Nurse
	robots: Robot, Cart
locations: TherapyArea
resources: Book
Nurse:
	1: stop
Cart:
	1: fetch Book
	2: moveTo TherapyArea
	3: deliver Book
Robot:
	1: moveTo TherapyArea
	2: follow Child
success: position(Robot, TherapyArea) && position(Cart, TherapyArea)
failure: tired(Robot)
