RobotCoffeeDelivery
agents:
	humans: Employee
	robots: CoffeeRobot
locations: UniversityBuilding, CoffeeMachineLocation, EmployeeLocation
resources: Coffee

CoffeeRobot: 
1: moveTo CoffeeMachineLocation
2: fetch Coffee
3: moveTo EmployeeLocation
4: deliver Coffee
5: moveTo UniversityBuilding

success: possess(CoffeeRobot, Coffee) && position(CoffeeRobot, EmployeeLocation)
failure: !possess(CoffeeRobot, Coffee) || !position(CoffeeRobot, EmployeeLocation)
