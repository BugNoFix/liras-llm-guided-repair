SampleTransportProtocol
	agents:
		humans: Nurse, LabTechnician, AuthorizedStaff
		robots: RoboticArm, DeliveryRobot
	locations: PatientFloor, Laboratory, StorageRoom, AnalysisMachine
	resources: Sample, SecureDrawer, BarcodeData, LogEntry

Nurse:
	1: moveTo PatientFloor
	2: pick Sample if possess(Nurse, SecureDrawer) else stop
	3: moveTo Laboratory if !tired else stop
	4: deliver Sample to DeliveryRobot
	5: moveTo StorageRoom

DeliveryRobot:
	1: receiveFrom Nurse
	2: moveTo Laboratory if !tired else stop
	3: deposit Sample if position(DeliveryRobot, Laboratory) else stop
	4: moveTo StorageRoom

RoboticArm default stop:
	1: pick Sample if position(RoboticArm, Laboratory) && possess(AuthorizedStaff, SecureDrawer) else stop
	2: moveTo AnalysisMachine if !busy(RoboticArm) else stop
	3: deliver Sample if position(RoboticArm, AnalysisMachine) else stop
	4: moveTo Laboratory

LabTechnician:
	1: moveTo Laboratory
	2: pick Sample if position(LabTechnician, Laboratory) && possess(LabTechnician, SecureDrawer) else stop
	3: moveTo AnalysisMachine if !tired else stop
	4: deliver Sample if position(LabTechnician, AnalysisMachine) else stop

AuthorizedStaff:
	1: moveTo StorageRoom
	2: pick SecureDrawer if position(AuthorizedStaff, StorageRoom) else stop
	3: moveTo Laboratory if !tired else stop

success: position(Sample, AnalysisMachine) && time(60)
failure: !position(Sample, AnalysisMachine) || time(120)
