ChemotherapyWardInteraction
	agents:
		humans: Child1, Child2, Parent1, Nurse
		robots: StorytellingRobot, BookCart
	locations: TherapyArea, WardEntrance, StorageRoom, NurseStation
	resources: StoryBook1, StoryBook2

StorytellingRobot:
	1: moveTo TherapyArea
	2: follow Nurse(StorageRoom) if position(Nurse, StorageRoom) else stop
	3: receiveFrom Nurse
	4: moveTo TherapyArea
	5: stop if time(120) else stop
	6-8: moveTo TherapyArea if !tired else moveTo NurseStation
	9: stop

BookCart:
	1: moveTo StorageRoom
	2: pick StoryBook1 if possess(Nurse, StoryBook1) else pick StoryBook2
	3: moveTo TherapyArea
	4: deliver StoryBook1 if position(StorytellingRobot, TherapyArea) else stop
	5: follow StorytellingRobot if !busy(StorytellingRobot) else stop
	6: leave StoryBook1 if position(StorytellingRobot, TherapyArea) else moveTo NurseStation
	7: stop

Nurse:
	1: moveTo StorageRoom
	2: fetch StoryBook1
	3: moveTo TherapyArea
	4: deliver StoryBook1 if position(StorytellingRobot, TherapyArea) else stop
	5: follow StorytellingRobot(TherapyArea) if !busy(StorytellingRobot) else stop
	6: stop

success: position(StorytellingRobot, TherapyArea) && position(BookCart, TherapyArea) && time(120)
failure: tired && !position(StorytellingRobot, TherapyArea)
