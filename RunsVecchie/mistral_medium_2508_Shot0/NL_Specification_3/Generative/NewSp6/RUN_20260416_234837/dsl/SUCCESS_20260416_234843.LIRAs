FactoryAutomation
	agents:
		robots: Robot1,Robot2
	locations: Warehouse,TexturizationStart,TexturizationEnd,LaserStart,LaserEnd,LoadingArea
	resources: RawMaterial

Robot1:
	1: pick RawMaterial if position(Robot1,Warehouse) else stop
	2: moveTo TexturizationStart
	3: leave RawMaterial if position(Robot1,TexturizationStart) else stop
	4: moveTo TexturizationEnd
	5: pick RawMaterial if position(Robot1,TexturizationEnd) else stop
	6: moveTo LaserStart
	7: leave RawMaterial if position(Robot1,LaserStart) else stop
	8: moveTo LaserEnd
	9: pick RawMaterial if position(Robot1,LaserEnd) else stop
	10: moveTo LoadingArea
	11: deposit RawMaterial if position(Robot1,LoadingArea) else stop
	12: moveTo Warehouse

Robot2:
	1: moveTo Warehouse
	2: pick RawMaterial if position(Robot2,Warehouse) else stop
	3: moveTo TexturizationStart
	4: leave RawMaterial if position(Robot2,TexturizationStart) else stop
	5: moveTo TexturizationEnd
	6: pick RawMaterial if position(Robot2,TexturizationEnd) else stop
	7: moveTo LaserStart
	8: leave RawMaterial if position(Robot2,LaserStart) else stop
	9: moveTo LaserEnd
	10: pick RawMaterial if position(Robot2,LaserEnd) else stop
	11: moveTo LoadingArea
	12: deposit RawMaterial if position(Robot2,LoadingArea) else stop
	13: moveTo Warehouse

success: position(Robot1,Warehouse) && position(Robot2,Warehouse) && !possess(Robot1,RawMaterial) && !possess(Robot2,RawMaterial)
failure: time(1000)
