HotelDeliveryService
	agents:
		robots: ButlerRobot
	locations: Lobby, Lift, Room101, Room102, StorageArea
	resources: GuestPackage

ButlerRobot:
	1: moveTo StorageArea
	2: pick GuestPackage
	3: moveTo Lift
	4: moveTo Room101 if position(ButlerRobot, Room101) else moveTo Room102
	5: deliver GuestPackage
	6: moveTo Lobby
success: position(ButlerRobot, Lobby) && !possess(ButlerRobot, GuestPackage)
failure: time(60) && possess(ButlerRobot, GuestPackage)
