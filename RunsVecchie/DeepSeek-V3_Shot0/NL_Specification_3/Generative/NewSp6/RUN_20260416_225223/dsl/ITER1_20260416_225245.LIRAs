FactoryTransport
agents:
	robots: Robot1, Robot2
locations: Warehouse, TexturizationStart, TexturizationEnd, LaserStart, LaserEnd, LoadingArea
resources: RawMaterial

Robot1:
	1: pick RawMaterial if possess(Robot1, RawMaterial) else stop
	2: moveTo TexturizationStart
	3: deposit RawMaterial if position(Robot1, TexturizationStart) else stop
	4: pick RawMaterial if possess(Robot1, RawMaterial) else stop
	5: moveTo LaserStart
	6: deposit RawMaterial if position(Robot1, LaserStart) else stop
	7: pick RawMaterial if possess(Robot1, RawMaterial) else stop
	8: moveTo LoadingArea
	9: deposit RawMaterial if position(Robot1, LoadingArea) else stop

Robot2:
	1: pick RawMaterial if possess(Robot2, RawMaterial) else stop
	2: moveTo TexturizationStart
	3: deposit RawMaterial if position(Robot2, TexturizationStart) else stop
	4: pick RawMaterial if possess(Robot2, RawMaterial) else stop
	5: moveTo LaserStart
	6: deposit RawMaterial if position(Robot2, LaserStart) else stop
	7: pick RawMaterial if possess(Robot2, RawMaterial) else stop
	8: moveTo LoadingArea
	9: deposit RawMaterial if position(Robot2, LoadingArea) else stop

success: position(RawMaterial, LoadingArea)
failure: !position(RawMaterial, LoadingArea) && time(60)
