HouseholdTransport
agents:
	humans: Human
	robots: Robot
locations: Bedroom, Kitchen
resources: Object

Human:
1: moveTo Bedroom
2: moveTo Kitchen if possess(Robot, Object) else stop

Robot:
1: moveTo Bedroom
2: pick Object if position(Human, Bedroom) else stop
3: follow Human(Kitchen) if possess(Robot, Object) else stop

success: position(Human, Kitchen) && position(Robot, Kitchen) && possess(Robot, Object)
failure: !possess(Robot, Object)
