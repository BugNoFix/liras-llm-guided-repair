HospitalDelivery
agents:
	humans: Human
	robots: Robot
locations: Room7002, Elevator7thFloor, Elevator3rdFloor, Room3201
resources: Basket, Object

Robot:
1: moveTo Room7002
2: stop if possess(Human, Object) else stop
3: moveTo Elevator7thFloor
4: stop if position(Human, Elevator7thFloor) else stop
5: moveTo Elevator3rdFloor if position(Human, Elevator7thFloor) else stop
6: stop if position(Human, Elevator3rdFloor) else stop
7: moveTo Room3201
8: stop if !possess(Human, Object) else stop

success: position(Robot, Room3201) && !possess(Human, Object)
failure: time(30)
