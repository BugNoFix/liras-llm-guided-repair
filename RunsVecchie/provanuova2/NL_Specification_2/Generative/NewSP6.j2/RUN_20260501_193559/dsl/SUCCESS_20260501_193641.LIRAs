SequentialTransport
agents:
	humans: Human1
	robots: Robot1
locations: bedroom, kitchen
resources: object
Robot1:
	1: moveTo bedroom
	2: pick object if position(Human1, bedroom) else stop until position(Human1, bedroom)
	3: follow Human1(kitchen)
Human1:
	1: moveTo bedroom
	2: moveTo kitchen if possess(Robot1, object) else stop until possess(Robot1, object)
success: position(Robot1, kitchen) && position(Human1, kitchen) && possess(Robot1, object)
failure: time(100)
