GoToKitchen

agents:
	humans: Human1
	robots: Robot1

locations: Bedroom, Kitchen
resources: Object1

Human1:
	1: moveTo Bedroom if !position(Human1, Bedroom) else stop
	5: moveTo Kitchen if position(Human1, Bedroom) else stop

Robot1:
	1: moveTo Bedroom if !position(Robot1, Bedroom) else stop
	2: pick Object1 if !possess(Robot1, Object1) && position(Robot1, Bedroom) else stop
	3: moveTo Kitchen if position(Robot1, Bedroom) else stop
	4: follow Human1 if position(Robot1, Kitchen) && !position(Human1, Kitchen) else stop

success: position(Human1, Kitchen) && position(Robot1, Kitchen) && possess(Robot1, Object1)
failure: position(Human1, Bedroom) || position(Robot1, Bedroom)
