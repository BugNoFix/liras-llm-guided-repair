LabSampleTransportation

agents:
humans: Nurse, LabPersonnel
robots: RoboticArm

locations: PatientFloor, Laboratory

resources: LabSample, SecureDrawer, BarcodeScanner, TrackSystem, AnalysisMachine

Nurse:
	1: receiveFrom LabPersonnel until possess TrackSystem
	2: moveTo PatientFloor if possess TrackSystem else stop
	3: pick LabSample if possess TrackSystem else stop
	4: moveTo Laboratory if possess LabSample else stop
	5: deliver LabSample if position(Nurse, Laboratory) else stop
	6: moveTo PatientFloor if still(Nurse) else stop

RoboticArm:
	1: moveTo Laboratory
	2: receiveFrom LabPersonnel until possess LabSample
	3: follow Nurse Laboratory until position(Nurse, Laboratory)
	4: pick LabSample if position(RoboticArm, Laboratory) and possess BarcodeScanner else stop
	5: moveTo AnalysisMachine if possess LabSample and position(RoboticArm, Laboratory) else stop
	6: deposit LabSample if position(RoboticArm, AnalysisMachine) else stop
	7: scan Barcode if possess LabSample and time(300) else stop

success: time(600)
failure: !position(Nurse, Laboratory) or !position(RoboticArm, AnalysisMachine)
