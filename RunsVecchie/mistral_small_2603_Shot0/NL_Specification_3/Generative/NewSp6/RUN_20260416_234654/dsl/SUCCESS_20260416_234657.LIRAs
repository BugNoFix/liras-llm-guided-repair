MedTransportAutomation
agents:
	humans: Supervisor
	robots: Robot1, Robot2
locations: Warehouse, SurfaceTexturizationStart, SurfaceTexturizationEnd, LaserStart, LaserEnd, LoadingArea
resources: RawMaterial

Robot1:
	1: moveTo Warehouse
	2: pick RawMaterial
	3: moveTo SurfaceTexturizationStart
	4: moveTo SurfaceTexturizationEnd
	5: leave RawMaterial
	6: moveTo LaserStart
	7: moveTo LaserEnd
	8: leave RawMaterial
	9: moveTo LoadingArea
	10: deliver RawMaterial

Robot2:
	1: moveTo Warehouse
	2: pick RawMaterial
	3: moveTo SurfaceTexturizationStart
	4: moveTo SurfaceTexturizationEnd
	5: leave RawMaterial
	6: moveTo LaserStart
	7: moveTo LaserEnd
	8: leave RawMaterial
	9: moveTo LoadingArea
	10: deliver RawMaterial

success: still(Robot1) && still(Robot2) && !possess(Robot1, RawMaterial) && !possess(Robot2, RawMaterial)
failure: time(60)
