Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: loading_area, surface_texturization_start, surface_texturization_end, laser_start, laser_end
resources: raw_materials
Robot1:
	1: moveTo surface_texturization_start
	2: pick raw_materials
	3: moveTo surface_texturization_end
	4: moveTo laser_start
	5: moveTo laser_end
	6: moveTo loading_area
	7: pick raw_materials
	8: moveTo loading_area
	9: deposit raw_materials
Robot2:
	1: moveTo surface_texturization_start
	2: pick raw_materials
	3: moveTo surface_texturization_end
	4: moveTo laser_start
	5: moveTo laser_end
	6: moveTo loading_area
	7: pick raw_materials
	8: moveTo loading_area
	9: deposit raw_materials
