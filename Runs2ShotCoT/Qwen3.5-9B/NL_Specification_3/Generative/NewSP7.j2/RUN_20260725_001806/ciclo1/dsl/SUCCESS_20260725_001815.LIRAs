Factory_Pipeline

agents:
	robots: Robot1, Robot2

locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials

Robot1:
	1-5: moveTo warehouse
	
	6: moveTo surface_texturization_start
	7: pick raw_materials
	8: moveTo surface_texturization_end
	9: follow Robot1 (surface_texturization_end)
	
	10: moveTo laser_start
	11: pick raw_materials
	12: moveTo laser_end
	13: follow Robot1 (laser_end)
	
	14: moveTo loading_area
	15: deposit raw_materials

Robot2:
	1-5: moveTo warehouse
	
	6: moveTo surface_texturization_start
	7: pick raw_materials
	8: moveTo surface_texturization_end
	9: follow Robot1 (surface_texturization_end)
	
	10: moveTo laser_start
	11: pick raw_materials
	12: moveTo laser_end
	13: follow Robot1 (laser_end)
	
	14: moveTo loading_area
	15: deposit raw_materials
