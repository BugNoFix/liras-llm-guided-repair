Coffee_Delivery

agents:
	humans: Employee
	robots: Robot1

locations: kitchen, bedroom
resources: coffee

Robot1:
	1: moveTo kitchen
	2: pick coffee
	3: moveTo bedroom until position(Employee, bedroom)
		4: follow Employee until position(Robot1, bedroom)
	
Employee:
	1: moveTo kitchen
	2: moveTo bedroom
	3: moveTo kitchen if position(Robot1, kitchen) else stop
	4: follow Robot1 until position(Robot1, bedroom)
