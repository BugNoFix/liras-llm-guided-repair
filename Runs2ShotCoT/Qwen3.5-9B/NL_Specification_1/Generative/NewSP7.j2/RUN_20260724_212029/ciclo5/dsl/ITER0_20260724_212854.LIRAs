Coffee_Delivery

agents:
	robots: Robot

locations: kitchen, bedroom, loading_area
resources: coffee, raw_materials

Robot:
	1: moveTo kitchen
	2: pick coffee
	3: moveTo bedroom
	4: deposit coffee
	5: moveTo loading_area if dist(Robot,kitchen)>=5 else stop
	6: moveTo bedroom until position(Robot,bedroom)
	7: pick raw_materials
	9: moveTo kitchen  
	10: deposit raw_materials
	11: moveTo loading_area if dist(Robot,bedroom)>=5 else stop
	12: stop
