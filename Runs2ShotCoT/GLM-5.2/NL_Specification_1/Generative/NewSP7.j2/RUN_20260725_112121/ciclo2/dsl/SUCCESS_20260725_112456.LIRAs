Coffee_Delivery

agents:
	humans: Employee
	robots: Robot

locations: bedroom, kitchen
resources: coffee

Robot:
	1: moveTo kitchen
	2: pick coffee
	3: moveTo bedroom
	4: deposit coffee
	5: moveTo bedroom if position(Robot, bedroom) else stop

Employee:
	1: moveTo bedroom
	2-4: moveTo bedroom if position(Employee, bedroom) else stop
	5: pick coffee
