Factory_Pipeline
agents:
	humans:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, object
Robot1:
	1: pick raw_materials
	2: moveTo surface_texturization_start
	3: deposit raw_materials
	4: moveTo surface_texturization_end
	5: pick object
	6: moveTo laser_start
	7: deposit object
	8: moveTo laser_end
	9: pick object
	10: moveTo loading_area
	11: deposit object
Robot2:
	1: pick raw_materials
	2: moveTo surface_texturization_start
	3: deposit raw_materials
	4: moveTo surface_texturization_end
	5: pick object
	6: moveTo laser_start
	7: deposit object
	8: moveTo laser_end
	9: pick object
	10: moveTo loading_area
	11: deposit object
