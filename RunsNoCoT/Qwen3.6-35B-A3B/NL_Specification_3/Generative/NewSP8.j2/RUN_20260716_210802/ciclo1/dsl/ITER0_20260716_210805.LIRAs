Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials

Robot1:
	1: pick raw_materials from warehouse
	2: moveTo surface_texturization_start
	3: deposit raw_materials at surface_texturization_start
	4: follow Robot1
	5: pick texturized_materials from surface_texturization_end
	6: moveTo laser_start
	7: deposit texturized_materials at laser_start
	8: follow Robot1
	9: pick lasered_materials from laser_end
	10: moveTo loading_area
	11: deposit lasered_materials at loading_area

Robot2:
	1: pick raw_materials from warehouse
	2: moveTo surface_texturization_start
	3: deposit raw_materials at surface_texturization_start
	4: follow Robot1
	5: pick texturized_materials from surface_texturization_end
	6: moveTo laser_start
	7: deposit texturized_materials at laser_start
	8: follow Robot1
	9: pick lasered_materials from laser_end
	10: moveTo loading_area
	11: deposit lasered_materials at loading_area
