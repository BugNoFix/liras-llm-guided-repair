Coffee_Delivery
agents:
	robots: Robot1
	humans: Employee1, Employee2
	locations: kitchen, warehouse, loading_area
	resources: coffee
Robot1:
	1: moveTo kitchen
	2: moveTo kitchen if position(Robot1, kitchen) else stop
	3: pick coffee
	4: moveTo warehouse
	5: moveTo loading_area
	6: deposit coffee
	7: stop
