user_guided_transport
agents:
	humans: Human1
	robots: Robot1
	locations: bedroom, kitchen
	resources: object
Human1:
	1: moveTo bedroom if position(Robot1, bedroom) else stop
	2: moveTo kitchen
Robot1:
	1: moveTo bedroom if position(Human1, bedroom) else stop
	2: z: pick object if position(Human1, bedroom) else stop
	3: moveTo kitchen if position(Human1, kitchen) else stop
