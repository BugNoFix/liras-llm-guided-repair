Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials
Robot1:
	1: pick raw_materials
	2: moveTo surface_texturization_start if position(Robot1,surface_texturization_start) else stop
	3: moveTo surface_texturization_end if position(Robot1,surface_texturization_start) else stop
	4: deposit raw_materials
	5: moveTo laser_start if position(Robot1,surface_texturization_end) else stop
	6: pick raw_materials
	7: moveTo laser_end if position(Robot1,laser_start) else stop
	8: deposit raw_materials
	9: moveTo loading_area if position(Robot1,laser_end) else stop
	10: pick raw_materials
	11: deposit raw_materials
Robot2:
	1: pick raw_materials
	2: moveTo surface_texturization_start if position(Robot2,surface_texturization_start) else stop
	3: moveTo surface_texturization_end if position(Robot2,surface_texturization_start) else stop
	4: deposit raw_materials
	5: moveTo laser_start if position(Robot2,surface_texturization_end) else stop
	6: pick raw_materials
	7: moveTo laser_end if position(Robot2,laser_start) else stop
	8: deposit raw_materials
	9: moveTo loading_area if position(Robot2,laser_end) else stop
	10: pick raw_materials
	11: deposit raw_materials
