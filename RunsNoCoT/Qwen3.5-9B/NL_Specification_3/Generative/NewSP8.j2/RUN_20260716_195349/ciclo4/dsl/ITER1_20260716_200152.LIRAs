Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials
Robot1:
	1: moveTo warehouse
	2: pick raw_materials if position(Robot1,warehouse) else stop
	3: moveTo surface_texturization_start if position(Robot1,warehouse) else stop
	4: moveTo surface_texturization_end if position(Robot1,surface_texturization_start) else stop
	5: deposit raw_materials if position(Robot1,surface_texturization_end) else stop
	6: moveTo laser_start if position(Robot1,surface_texturization_end) else stop
	7: pick raw_materials if position(Robot1,laser_start) else stop
	8: moveTo laser_end if position(Robot1,surface_texturization_end) else stop
	9: deposit raw_materials if position(Robot1,laser_end) else stop
	10: moveTo loading_area if position(Robot1,laser_end) else stop
	11: pick raw_materials if position(Robot1,loading_area) else stop
Robot2:
	1: moveTo warehouse
	2: pick raw_materials if position(Robot2,warehouse) else stop
	3: moveTo surface_texturization_start if position(Robot2,warehouse) else stop
	4: moveTo surface_texturization_end if position(Robot2,surface_texturization_start) else stop
	5: deposit raw_materials if position(Robot2,surface_texturization_end) else stop
	6: moveTo laser_start if position(Robot2,surface_texturization_end) else stop
	7: pick raw_materials if position(Robot2,laser_start) else stop
	8: moveTo laser_end if position(Robot2,surface_texturization_end) else stop
	9: deposit raw_materials if position(Robot2,laser_end) else stop
	10: moveTo loading_area if position(Robot2,laser_end) else stop
	11: pick raw_materials if position(Robot2,loading_area) else stop
