Factory_Pipeline
agents:
	humans:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials
Robot1:
	1: moveTo warehouse
	2-3: pick raw_materials
	4: moveTo surface_texturization_start
	5: deposit raw_materials
	6: moveTo surface_texturization_end
	7: pick raw_materials
	8: moveTo laser_start
	9: deposit raw_materials
	10: moveTo laser_end
	11: pick raw_materials
	12: moveTo loading_area
	13: deposit raw_materials
Robot2:
	1-2: moveTo warehouse
	3: pick raw_materials
	4-5: moveTo surface_texturization_start
	6-7: deposit raw_materials
	8: moveTo surface_texturization_end
	9-10: pick raw_materials
	11: moveTo laser_start
	12-13: deposit raw_materials
