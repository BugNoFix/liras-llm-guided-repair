Factory_Pipeline
agents:
	humans:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, diffusion_start, diffusion_end, laser_start, laser_end, etching_start, etching_end, annealing_start, annealing_end, perc_start, perc_end, rear_top_paste_start, rear_top_paste_end, laser_slotting_start, laser_slotting_end, loading_area, bedroom, kitchen
