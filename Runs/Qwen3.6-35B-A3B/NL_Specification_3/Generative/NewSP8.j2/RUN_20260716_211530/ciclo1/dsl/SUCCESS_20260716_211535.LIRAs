Factory_Pipeline
agents:
	robots: Robot1,Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials, lasered_materials
Robot1:
	1: pick raw_materials
	2: moveTo warehouse
	3: stop
	4: pick raw_materials
	5: moveTo surface_texturization_start
	6: stop
	7: deposit raw_materials
	8: pick texturized_materials
	9: moveTo surface_texturization_end
	10: stop
	11: deposit texturized_materials
	12: pick lasered_materials
	13: moveTo laser_start
	14: stop
	15: deposit texturized_materials
	16: pick lasered_materials
	17: moveTo laser_end
	18: stop
	19: deposit lasered_materials
	20: stop
Robot2:
	1: stop
	2: stop
	3: stop
	4: pick raw_materials
	5: moveTo warehouse
	6: stop
	7: pick raw_materials
	8: moveTo surface_texturization_start
	9: stop
	10: deposit raw_materials
	11: pick texturized_materials
	12: moveTo surface_texturization_end
	13: stop
	14: deposit texturized_materials
	15: pick lasered_materials
	16: moveTo laser_start
	17: stop
	18: deposit texturized_materials
	19: pick lasered_materials
	20: moveTo laser_end
	21: stop
	22: deposit lasered_materials
	23: moveTo loading_area
	24: stop
