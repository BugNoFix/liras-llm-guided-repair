Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials, lasered_materials

Robot1:
	1: pick raw_materials
	2: moveTo surface_texturization_start
	3: deposit raw_materials
	4: follow Robot2
	5: pick texturized_materials
	6: moveTo laser_start
	7: deposit texturized_materials
	8: follow Robot2
	9: pick lasered_materials
	10: moveTo loading_area
	11: deposit lasered_materials

Robot2:
	1: pick raw_materials
	2: moveTo surface_texturization_start
	3: deposit raw_materials
	4: follow Robot1
	5: pick texturized_materials
	6: moveTo laser_start
	7: deposit texturized_materials
	8: follow Robot1
	9: pick lasered_materials
	10: moveTo loading_area
	11: deposit lasered_materials
