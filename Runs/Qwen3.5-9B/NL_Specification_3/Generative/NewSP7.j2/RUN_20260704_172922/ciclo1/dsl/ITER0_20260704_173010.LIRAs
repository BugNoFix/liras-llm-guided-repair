factory_pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, item2

Robot1:
	1: pick raw_materials moveTo surface_texturization_start else stop
	2: pick raw_materials deposit raw_materials moveTo surface_texturization_end else stop
	3: pick item2 moveTo laser_start else stop
	4: pick item2 deposit item2 moveTo laser_end else stop
	5: pick item2 moveTo loading_area else stop
	6: deposit item2

Robot2:
	1: pick raw_materials moveTo surface_texturization_start else stop
	2: pick raw_materials deposit raw_materials moveTo surface_texturization_end else stop
	3: pick item2 moveTo laser_start else stop
	4: pick item2 deposit item2 moveTo laser_end else stop
	5: pick item2 moveTo loading_area else stop
	6: deposit item2

Conclusion:
	raw_materials == 2 && item2 == 2
