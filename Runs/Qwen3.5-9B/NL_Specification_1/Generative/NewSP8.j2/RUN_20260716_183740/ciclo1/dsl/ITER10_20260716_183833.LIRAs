Coffee_Delivery
agents:
	robots: Robot1
	locations: kitchen, office001
	resources: coffee
1: moveTo kitchen
2: pick coffee
3: moveTo office001
4: deposit coffee
5: stop
6: moveTo kitchen if position(Robot1, kitchen) else stop
7: pick coffee if position(Robot1, kitchen) else stop
8: moveTo office001 if position(Robot1, kitchen) else stop
9: deposit coffee if position(Robot1, kitchen) else stop
10: stop
