user_guided_transport
agents:
 robotic_helpers:
humans: Otto
robots: Plato
locations: bedroom, kitchen
resources: obj
Otto:
	1: moveTo bedroom
Plato:
	1: moveTo bedroom
	2: pick obj
	3: moveTo kitchen if position(Plato,kitchen) else stop
	4: follow Otto
Otto:
	3: moveTo kitchen if position(Plato,kitchen) else stop
