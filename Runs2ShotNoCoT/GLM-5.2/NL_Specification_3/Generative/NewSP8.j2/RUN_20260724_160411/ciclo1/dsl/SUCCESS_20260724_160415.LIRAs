Factory_Pipeline

agents:
	robots: Robot1, Robot2

locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials

Robot1:
	1: moveTo warehouse until position(Robot1, warehouse)
	3: pick raw_materials
	5: moveTo surface_texturization_start

Robot2:
	2: moveTo surface_texturization_end until position(Robot1, surface_texturization_start)
	4: pick raw_materials if position(Robot1, warehouse) else stop
	6: moveTo laser_start until position(Robot1, laser_end)
