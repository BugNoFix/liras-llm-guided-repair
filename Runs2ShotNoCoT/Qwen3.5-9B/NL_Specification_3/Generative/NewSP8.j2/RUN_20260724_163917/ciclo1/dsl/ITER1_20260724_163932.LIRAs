Factory_Pipeline
agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials
Robot1:
	1: moveTo warehouse
	2: pick raw_materials
	3: follow Robot2 (surface_texturization_start)
	4: deposit raw_materials until position(Robot1, surface_texturization_start)
	5: moveTo surface_texturization_end
	6: pick raw_materials
	7: follow Robot2 (laser_start)
	8: deposit raw_materials until position(Robot1, laser_start)
	9: moveTo laser_end
	10: pick raw_materials
	11: moveTo loading_area
	12: deposit raw_materials
Robot2:
	1: moveTo surface_texturization_start
	2: follow Robot1 (surface_texturization_start)
	3: moveTo surface_texturization_end
	4: follow Robot1 (laser_start)
	5: moveTo laser_end
	6: follow Robot1 (loading_area)
