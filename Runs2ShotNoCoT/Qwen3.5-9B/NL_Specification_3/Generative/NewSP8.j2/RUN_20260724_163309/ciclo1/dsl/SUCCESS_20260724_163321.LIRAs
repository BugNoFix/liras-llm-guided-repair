Factory_Pipeline

agents:
	robots: Robot1, Robot2

locations: warehouse, surface_texturization_start, surface_texturization_end, diffusion_start, diffusion_end, laser_start, laser_end, etching_start, etching_end, annealing_start, annealing_end, perc_start, perc_end, rear_top_paste_start, rear_top_paste_end, laser_slotting_start, laser_slotting_end, loading_area
resources: raw_materials

Robot1:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: moveTo surface_texturization_end
	5: moveTo diffusion_start
	6: moveTo diffusion_end
	7: moveTo laser_start
	8: moveTo laser_end
	9: moveTo loading_area
	
Robot2:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: moveTo surface_texturization_end
	5: moveTo diffusion_start
	6: moveTo diffusion_end
	7: moveTo laser_start
	8: moveTo laser_end
	9: moveTo loading_area
