Factory_Pipeline
agents:
	robots: Robot1, Robot2

locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials

Robot1:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start
	4: deposit raw_materials
	5: follow Robot2 (surface_texturization_end)
	6: moveTo surface_texturization_end
	7: pick raw_materials
	8: moveTo laser_start
	9: deposit raw_materials
	10: follow Robot2 (laser_end)
	11: moveTo laser_end
	12: pick raw_materials
	13: moveTo loading_area
	14: deposit raw_materials

Robot2:
	1: moveTo surface_texturization_start if position(Robot1, warehouse) else stop
	2: moveTo surface_texturization_end if position(Robot1, surface_texturization_end) else stop
	3: follow Robot1 (surface_texturization_end)
	4: moveTo surface_texturization_end
	5: pick raw_materials
	6: moveTo laser_start
	7: deposit raw_materials
	8: follow Robot1 (laser_end)
	9: moveTo laser_end
	10: pick raw_materials
	11: moveTo loading_area
	12: deposit raw_materials
