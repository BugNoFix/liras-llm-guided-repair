Factory_Pipeline

agents:
	robots: Robot1, Robot2
locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials

Robot1:
	1: moveTo warehouse
	2: pick raw_materials
	3: moveTo surface_texturization_start until position(Robot2, warehouse)
	4: moveTo surface_texturization_end
	5: pick raw_materials
	6: moveTo laser_start
	7: moveTo laser_end

Robot2:
	1: moveTo warehouse
	2: moveTo warehouse until position(Robot1, warehouse)
	3: pick raw_materials
	4: moveTo surface_texturization_start
	5: moveTo surface_texturization_end until position(Robot1, surface_texturization_start)
	6: pick raw_materials
	7: moveTo laser_start until position(Robot1, surface_texturization_end)
	8: moveTo laser_end
	9: moveTo loading_area
	10: moveTo loading_area until position(Robot1, laser_end)
	11: deposit raw_materials
	12: moveTo laser_start
	13: moveTo laser_end
	14: moveTo loading_area
	15: deposit raw_materials
