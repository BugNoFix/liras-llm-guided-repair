Factory_Pipeline

agents:
	robots: Robot1, Robot2

locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials

Robot1:
	1: moveTo warehouse until position(Robot1, warehouse)
	2: pick raw_materials
	3: moveTo surface_texturization_start until position(Robot1, surface_texturization_start)
	4: moveTo surface_texturization_end
	5: deposit texturized_materials until position(Robot1, surface_texturization_end)
	6: moveTo laser_start until position(Robot1, surface_texturization_end)
	7: moveTo laser_end
	8: deposit texturized_materials until position(Robot1, laser_end)
	9: moveTo loading_area until position(Robot1, laser_end)
	10: deposit texturized_materials

Robot2:
	1: moveTo warehouse until position(Robot2, warehouse)
	2: pick raw_materials
	3: moveTo surface_texturization_start until position(Robot2, surface_texturization_start)
	4: moveTo surface_texturization_end
	5: deposit texturized_materials until position(Robot2, surface_texturization_end)
	6: moveTo laser_start until position(Robot2, surface_texturization_end)
	7: moveTo laser_end
	8: deposit texturized_materials until position(Robot2, laser_end)
	9: moveTo loading_area until position(Robot2, laser_end)
	10: deposit texturized_materials
