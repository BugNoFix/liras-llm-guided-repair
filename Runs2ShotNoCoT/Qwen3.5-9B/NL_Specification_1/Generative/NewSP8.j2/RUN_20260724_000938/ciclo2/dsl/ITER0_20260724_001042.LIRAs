Coffee_Delivery

agents:
	robots: Robot1

humans: Employee1

locations: coffee_room, office001, office_room

resources: coffee

Robot1:
	1: moveTo coffee_room
	2: pick coffee
	3: moveTo office001
	4: follow Employee1 (office_room)
	5: stop
	
Employee1:
	1: moveTo office_room
	2: moveTo office001
	3: follow Robot1
	4: moveTo office_room until position(Robot1, office001)
	5: moveTo office001
