user_guided_transport

agents:
	humans: Human
	robots: Robot1

locations: bedroom, kitchen

resources: object

Human:
	1: moveTo bedroom
	2: moveTo kitchen

Robot1:
	1: moveTo bedroom if position(Human, bedroom) else stop
	2: pick object if position(Human, bedroom) else stop
	3: moveTo kitchen if position(Human, bedroom) else stop
	4: moveTo kitchen if position(Human, kitchen) else stop
