user_guided_transport

agents:
	humans: Human1
	robots: Robot1
locations: bedroom, kitchen
resources: item1

Human1:
	1: moveTo bedroom
	
	2: moveTo kitchen if event(pick_item1) else stop
	
Robot1:
	1: moveTo bedroom
	
	2: pick item1
	3: follow Human1
	
	4: moveTo kitchen
	5: deposit item1
	6: stop
