Factory_Pipeline

agents:
	robots: Robot1, Robot2

locations: warehouse, surface_texturization_start, surface_texturization_end, laser_start, laser_end, loading_area
resources: raw_materials, texturized_materials, lasered_materials

Robot1:
	1: moveTo warehouse
	pick raw_materials
	else stop
	2: moveTo surface_texturization_start
	deposit raw_materials
	else stop
	3: moveTo surface_texturization_end
	pick texturized_materials
	else stop
	4: moveTo laser_start
	deposit texturized_materials
	else stop
	5: moveTo laser_end
	pick lasered_materials
	else stop
	6: moveTo loading_area
	deposit lasered_materials
	else stop

Robot2:
	1: moveTo warehouse
	pick raw_materials
	else stop
	2: moveTo surface_texturization_start
	deposit raw_materials
	else stop
	3: moveTo surface_texturization_end
	pick texturized_materials
	else stop
	4: moveTo laser_start
	deposit texturized_materials
	else stop
	5: moveTo laser_end
	pick lasered_materials
	else stop
	6: moveTo loading_area
	deposit lasered_materials
	else stop
